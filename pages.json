	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#fff6df",
		"backgroundColor": "#fff6df"
	},
	"tabBar": {
		"custom": true,
		"color": "#888888",
		"selectedColor": "#fff6df",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/index/index360",
				"text": "首頁",
				"iconPath": "static/tabbar/home-no.png",
				"selectedIconPath": "static/tabbar/home-active.png"
			},
			{
				"pagePath": "pages/likes/likes",
				"text": "点赞",
				"iconPath": "static/img/like.png",
				"selectedIconPath": "static/img/like_act.png"
			},
			{
				"pagePath": "pages/notice/notice",
				"text": "消息",
				"iconPath": "static/tabbar/notice-no.png",
				"selectedIconPath": "static/tabbar/notice-active.png"
			},
			{
				"pagePath": "pages/my/myLifeShow/myLifeShow",
				"text": "个人资料",
				"iconPath": "static/tabbar/my-no.png",
				"selectedIconPath": "static/tabbar/my-active.png"
			}
		]
