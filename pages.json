{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/login/login360",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/index/index360",
			"style": {
				"navigationBarTitleText": "幸福人生",
				"navigationBarBackgroundColor": "#f5f5f7",
				"enablePullDownRefresh": true,
				"onReachBottomDistance": 100
			}
		},
		{
			"path": "pages/account/accountCenter",
			"style": {
				"navigationBarTitleText": "个人中心",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/legal/userAgreement",
			"style": {
				"navigationBarTitleText": "用户服务协议"
			}
		},
		{
			"path": "pages/legal/privacyPolicy",
			"style": {
				"navigationBarTitleText": "隐私政策"
			}
		},
